# ============================================================
#  KWIKAR — Apache settings for Hostinger (public_html/.htaccess)
# ============================================================
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
ErrorDocument 410 /410.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# --- One address for Google: www.kwikar.com -> kwikar.com (first, so http://www needs only one 301) ---
RewriteCond %{HTTP_HOST} ^www\.kwikar\.com$ [NC]
RewriteRule ^ https://kwikar.com%{REQUEST_URI} [L,R=301]

# --- Always use HTTPS ---
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Old addresses from the previous website ---
RewriteRule ^home\.html$ / [R=301,L]
RewriteRule ^holidays\.html$ /holidays [R=301,L]
RewriteRule ^transfers\.html$ /transfers [R=301,L]
RewriteRule ^visa\.html$ /visa [R=301,L]
RewriteRule ^contact\.html$ /contact [R=301,L]
# --- Tour pages: old numeric addresses -> new addresses (generated by build.py) ---
RewriteRule ^(?:ar/)?tour/3(?::[a-z0-9:]+)?/?$ /activities/dubai/modern-dubai-city-tour-with-sightseeing-cruise-russian-speaking-guide [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)id=3(?:&|$)
RewriteRule ^tour\.html$ /activities/dubai/modern-dubai-city-tour-with-sightseeing-cruise-russian-speaking-guide? [R=301,L]

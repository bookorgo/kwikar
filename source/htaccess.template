# ============================================================
#  KWIKAR — Apache settings for Hostinger (public_html/.htaccess)
# ============================================================
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
ErrorDocument 410 /410.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# --- One address for Google: www.kwikar.com -> kwikar.com (first, so http://www needs only one 301) ---
RewriteCond %{HTTP_HOST} ^www\.kwikar\.com$ [NC]
RewriteRule ^ https://kwikar.com%{REQUEST_URI} [L,R=301]

# --- Always use HTTPS ---
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Old addresses from the previous website ---
RewriteRule ^home\.html$ / [R=301,L]
RewriteRule ^holidays\.html$ /holidays [R=301,L]
RewriteRule ^transfers\.html$ /transfers [R=301,L]
RewriteRule ^visa\.html$ /visa [R=301,L]
RewriteRule ^contact\.html$ /contact [R=301,L]
# --- Tour pages: old numeric addresses -> new addresses (generated by build.py) ---
# {{TOUR_RULES}}
RewriteRule ^tour\.html$ /activities? [R=301,L]
RewriteRule ^activities/events:o6vcym(:0)?$ /activities/events [R=301,L]
RewriteRule ^destinations/sharjah:numxfl:0$ /destinations/sharjah [R=301,L]
RewriteRule ^privacy-policy/?$ /privacy [R=301,L]
# Pages that no longer exist (online payment, accounts, admin)
RewriteRule ^(bookings|account|wishlist)(/.*)?$ /contact [R=301,L]
RewriteRule ^(pay|booking)(/.*)?$ /contact [R=301,L]
RewriteRule ^(admin|staff)(/.*)?$ / [R=301,L]
# Old car pages -> the fleet (known models -> their own page)
RewriteRule ^(?:ar/)?car/(mercedes-vito|mercedes-v-class)/?$ /transfers/fleet/mercedes-v-class [R=301,L]
RewriteRule ^(?:ar/)?car/(bmw-740i|bmw-7-series)/?$ /transfers/fleet/bmw-7-series [R=301,L]
RewriteRule ^(?:ar/)?car/(mercedes-s-class|mercedes-benz-s-class)/?$ /transfers/fleet/mercedes-s-class [R=301,L]
RewriteRule ^(?:ar/)?car/(mercedes-e-class|mercedes-benz-e-class)/?$ /transfers/fleet/mercedes-e-class [R=301,L]
RewriteRule ^(?:ar/)?car/(cadillac-escalade|gmc-yukon-xl|tesla-model-y|lexus-es-300h|bmw-530i)/?$ /transfers/fleet/$1 [R=301,L]
RewriteRule ^(?:ar/)?car(/.*)?$ /transfers/fleet [R=301,L]
# Old city pages (also with the /ar/ prefix, one hop). Cities without their own page -> the nearest live page
RewriteRule ^(?:ar/)?location/al-ain/?$ /transfers/private-tours/al-ain-garden-city-tour [R=301,L]
RewriteRule ^(?:ar/)?location/ras-al-khaimah(?:-emirates)?/?$ /destinations/ras-al-khaimah [R=301,L]
RewriteRule ^(?:ar/)?location/([a-z-]+)/?$ /destinations/$1 [R=301,L]
RewriteRule ^attractions/?$ /destinations [R=301,L]
RewriteRule ^destinations/other/?$ /activities/uae [R=301,L]
RewriteRule ^api/sitemap-tours\.php$ /sitemap-products.xml [R=301,L]
# Old blog, tour search and info pages
RewriteRule ^(?:ar/)?news(/.*)?$ /blog? [R=301,L]
RewriteRule ^(?:ar/)?tour/?$ /activities? [R=301,L]
# Old tour pages by name (GSC 404s, 14 Nov 2026): holiday packages -> /holidays, tours -> the matching page
RewriteRule ^(?:ar/)?tour/[a-z0-9-]+-\d+n\d+d(?:-[a-z0-9-]*)?/?$ /holidays? [R=301,L]
RewriteRule ^(?:ar/)?tour/combo-save-[a-z0-9-]*hop-on-hop-off[a-z0-9-]*/?$ /activities/city-tours? [R=301,L]
RewriteRule ^(?:ar/)?tour/inside-burj-al-arab[a-z0-9-]*/?$ /activities/attraction-tickets? [R=301,L]
RewriteRule ^(?:ar/)?tour/from-dubai-abu-dhabi-full-day-city-tour[a-z0-9-]*/?$ /transfers/private-tours/abu-dhabi-day-tour? [R=301,L]
RewriteRule ^(?:ar/)?tour/self-drive-jet-ski-tour[a-z0-9-]*/?$ /activities/dubai/jet-ski-from-dubai-harbour? [R=301,L]
# Any other old tour name (never a live page: tours live under /activities/) -> all experiences
RewriteRule ^(?:ar/)?tour/[a-z][a-z0-9-]*/?$ /activities? [R=301,L]
# Removed sections of the old site -> the nearest hub
RewriteRule ^(?:ar/)?event(/.*)?$ /activities/events? [R=301,L]
RewriteRule ^(?:ar/)?boat(/.*)?$ /activities/yachts? [R=301,L]
RewriteRule ^(?:ar/)?flight(/.*)?$ /holidays? [R=301,L]
RewriteRule ^(?:ar/)?(forgot-password|login|register)/?$ /? [R=301,L]
RewriteRule ^(?:ar/)?page/become-a-vendor/?$ /contact [R=301,L]
RewriteRule ^(?:ar/)?page/.*$ /about? [R=301,L]
# Old currency / language switches -> the same page without them (/ar home first, one hop)
RewriteCond %{QUERY_STRING} (^|&)(set_currency|set_lang)= [NC]
RewriteRule ^ar/?$ /? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(set_currency|set_lang)= [NC]
RewriteRule ^(.*)$ /$1? [R=301,L]
# Odd addresses with a ":code" suffix -> the clean address
RewriteRule ^(.+?):[a-z0-9:]+$ /$1 [R=301,L]
# Arabic section of the old site -> the English page
RewriteRule ^ar/?$ / [R=301,L]
RewriteRule ^ar/(.+)$ /$1 [R=301,L]
# Pages removed for good
RewriteRule ^space/?$ - [G,L]


# --- Clean addresses without a trailing slash (/holidays, /destinations/dubai) ---
# /holidays/  ->  /holidays
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.+)/$ /$1 [R=301,L]
# /holidays  ->  /holidays/index.html
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)$ /$1/index.html [L]
</IfModule>

# Folders without a slash are handled above
DirectorySlash Off

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # pages always revalidate, so visitors see updates straight away
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Browser caching (file names carry ?v= so updates show immediately) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

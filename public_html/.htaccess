# Pages that no longer exist (online payment, accounts, admin)
RewriteRule ^(bookings|account|wishlist)(/.*)?$ /contact [R=301,L]
RewriteRule ^(pay|booking)(/.*)?$ /contact [R=301,L]
RewriteRule ^(admin|staff)(/.*)?$ / [R=301,L]
RewriteRule ^ar/car/.*$ /transfers [R=301,L]
RewriteRule ^car/.*$ /transfers [R=301,L]
RewriteRule ^location/([a-z-]+)/?$ /destinations/$1 [R=301,L]
RewriteRule ^attractions/?$ /destinations [R=301,L]
RewriteRule ^api/sitemap-tours\.php$ /sitemap-products.xml [R=301,L]


# --- Clean addresses without a trailing slash (/holidays, /destinations/dubai) ---
# /holidays/  ->  /holidays
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.+)/$ /$1 [R=301,L]
# /holidays  ->  /holidays/index.html
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)$ /$1/index.html [L]
</IfModule>

# Folders without a slash are handled above
DirectorySlash Off

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Browser caching (file names carry ?v= so updates show immediately) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
